                            <td style="color: #000000; text-align: center; vertical-align: middle; font-size: 24px; font-weight: bold">SMART ASSET WEB</td>
                            <td style="width: 168px; vertical-align: top">
                                 <div style="text-align: right; padding: 3px">
                                    <a href="../Forms/HuongDanSuDung.aspx" target="_blank">Hướng dẫn sử dụng</a>
                                </div>
                                <div style="text-align: right; padding: 3px">
                                    <a href="../Actions/FileDownloadAction.ashx?id=1" target="_blank">Hướng dẫn sử dụng</a>
                                </div>

                                <div style="text-align: right; padding: 3px">
                                    <dx:ASPxLabel ForeColor="#415698" Font-Bold="true" runat="server" ID="lblUserFullName"></dx:ASPxLabel>
                                </div>
                                <div style="text-align: right; padding: 3px">
                                    <dx:ASPxHyperLink runat="server" ID="lnkLogout" NavigateUrl="../Actions/Logout.ashx" Text="Thoát"></dx:ASPxHyperLink>
                                </div>

                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
            <tr>
                <td>
                    <table style="width: 100%">
                        <tr>
                            <td style="vertical-align: top; width: 239px">
                                <dx:ASPxNavBar ID="nvbMain" runat="server" EnableTheming="True" Theme="BlackGlass" Width="229px">
                                </dx:ASPxNavBar>
                            </td>
                            <td style="vertical-align: top">
                                <div>
                                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
                                </div>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table> --%>


        <section class="section-header">
            <div class="container">

                <div class="logo">
                    <a href="../">
                        <img src="../Images/logo.png" />
                    </a>

                </div>

                <div class="col-center-header">
                    <h1>RUN DRAGON ADMIN
                        <dx:ASPxHyperLink runat="server" ID="lh" NavigateUrl="../Files/sDragonLienHe.html" Text="Liên hệ"></dx:ASPxHyperLink>
                    </h1>
                </div>

                <div class="col-right-header">
                    <div class="content" style="display: flex; align-items: center; gap: 15px; flex-wrap: nowrap;">
                        <%--  <p class="user-guide"><a href="../Forms/HelpDeskGuide.aspx" target="_blank">Hướng dẫn sử dụng</a></p>--%>
                        <span><a href="../Forms/HelpDeskGuide.aspx" target="_blank">Hướng dẫn sử dụng</a></span>
                        <span>
                            <dx:ASPxLabel ID="lblUserFullName" ClientInstanceName="lblUserFullName" runat="server"></dx:ASPxLabel>
                        </span>
                        <span>
                            <dx:ASPxHyperLink runat="server" ID="lnkLogout" NavigateUrl="../Actions/Logout.ashx" Text="Thoát"></dx:ASPxHyperLink>
                        </span>
                    </div>
                </div>
            </div>
        </section>



        <div class="dark_bg_black"></div>

        <%-- Menu ngang --%>
        <div id="top_menu_navbar">
            <dx:ASPxMenu ID="nvbMain" runat="server" Orientation="Horizontal"
                BackColor="#1a1a1a" ForeColor="White"
                ItemAutoWidth="True">
            </dx:ASPxMenu>
        </div>

        <%-- Breadcrumb --%>
        <div id="breadcrumb_bar">
            <asp:Label ID="lblBreadcrumb" runat="server" Text=""></asp:Label>
        </div>

        <%-- Nội dung chính --%>
        <div id="main_content">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>
